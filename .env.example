# Postgres
POSTGRES_USER=intermitente
POSTGRES_PASSWORD=changeme
POSTGRES_DB=intermitente

# Backend
SESSION_SECRET=changeme-generate-a-long-random-string

# First admin bootstrap (created by prisma/seed.ts if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=changeme

# Frontend
WEB_PORT=8080

# pgAdmin (optional, only starts with: docker compose --profile tools up -d)
PGADMIN_EMAIL=pgadmin@example.com
PGADMIN_PASSWORD=changeme
PGADMIN_PORT=5050
