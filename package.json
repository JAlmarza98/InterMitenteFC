{
  "name": "inter-mitente",
  "version": "1.6.0",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "test:keep-db": "node scripts/test-all.mjs --keep-db",
    "test:backend": "npm --prefix backend test",
    "test:backend:unit": "npm --prefix backend run test:unit",
    "test:backend:integration": "npm --prefix backend run test:integration",
    "test:frontend": "npm --prefix frontend test",
    "test:e2e": "npm --prefix e2e test",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v"
  }
}
